<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Cheari.Controls"
                    xmlns:legend="clr-namespace:Cheari.Controls.Legend"
                    xmlns:controls="clr-namespace:Cheari.Controls.Controls"
                    xmlns:converters="clr-namespace:Cheari.Controls.Converters"
                    xmlns:annotations="clr-namespace:Cheari.Controls.Annotations"
                    xmlns:axesControls="clr-namespace:Cheari.Controls.Axes.Controls"
                    xmlns:vortice="clr-namespace:Vortice.Wpf;assembly=Vortice.Wpf">

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style TargetType="{x:Type axesControls:AxisControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type axesControls:AxisControl}">
                    <Grid x:Name="PART_Root" ClipToBounds="True">
                        <Border x:Name="PART_TitleHost" Background="Transparent">
                            <TextBlock x:Name="PART_Title"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Canvas x:Name="PART_ContentHost" ClipToBounds="True">
                            <Line x:Name="PART_AxisLine" SnapsToDevicePixels="True" />
                            <Canvas x:Name="PART_TickHost" ClipToBounds="True" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type legend:LegendControl}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="LegendSpacing" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type legend:LegendControl}">
                    <Border x:Name="PART_LegendBorder"
                            Background="#CC1A1A2E"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            Padding="6">
                        <StackPanel x:Name="PART_ItemsHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ColorEditor}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ColorEditor}">
                    <Border Background="#1E2233"
                            BorderBrush="#3A3D4A"
                            BorderThickness="1"
                            CornerRadius="6" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Image x:Name="PART_SpectrumImage"
                                           Width="200" Height="150"
                                           Stretch="Fill" />
                                    <Canvas x:Name="PART_SpectrumCanvas"
                                            Width="200" Height="150"
                                            Background="Transparent" />
                                </Grid>

                                <Grid Grid.Column="1" Margin="6,0,0,0">
                                    <Image x:Name="PART_HueBarImage"
                                           Width="20" Height="150"
                                           Stretch="Fill" />
                                    <Canvas x:Name="PART_HueBarCanvas"
                                            Width="20" Height="150"
                                            Background="Transparent" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,4,0,4"
                                  Visibility="{Binding ShowAlpha, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alpha" Foreground="#8890A0" VerticalAlignment="Center"
                                           FontSize="11" Margin="0,0,8,0" />
                                <Slider x:Name="PART_AlphaSlider" Grid.Column="1"
                                        Minimum="0" Maximum="255" Value="255"
                                        Height="16" IsSnapToTickEnabled="False">
                                    <Slider.Template>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid>
                                                <Border Height="4"
                                                        Background="#3A3D4A" CornerRadius="2"
                                                        VerticalAlignment="Center" />
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate>
                                                                    <Border Height="4" Background="#4A90D9"
                                                                            CornerRadius="2" />
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="12" Height="12">
                                                            <Thumb.Template>
                                                                <ControlTemplate>
                                                                    <Border Background="#4A90D9"
                                                                            CornerRadius="6"
                                                                            BorderBrush="#FFFFFF"
                                                                            BorderThickness="1" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate>
                                                                    <Border Height="4" Background="#2A2D3A"
                                                                            CornerRadius="2" />
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Slider.Template>
                                </Slider>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="PART_OldPreview"
                                            Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            BorderBrush="#3A3D4A"
                                            BorderThickness="1" />
                                    <Border x:Name="PART_NewPreview"
                                            Grid.Column="1" Margin="4,0,0,0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            BorderBrush="#3A3D4A"
                                            BorderThickness="1" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="#" Foreground="#8890A0"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBox x:Name="PART_HexBox"
                                                 Width="80" Height="24"
                                                 FontSize="12"
                                                 Background="#2A2D3A"
                                                 Foreground="#E0E0F0"
                                                 BorderBrush="#3A3D4A"
                                                 BorderThickness="1"
                                                 VerticalContentAlignment="Center"
                                                 Text="#FF0000" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="R" FontSize="10" Foreground="#8890A0" />
                                        <TextBox x:Name="PART_RBox" FontSize="12"
                                                 Background="#2A2D3A" Foreground="#E0E0F0"
                                                 BorderBrush="#3A3D4A" BorderThickness="1"
                                                 Height="24" Text="255"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="G" FontSize="10" Foreground="#8890A0" />
                                        <TextBox x:Name="PART_GBox" FontSize="12"
                                                 Background="#2A2D3A" Foreground="#E0E0F0"
                                                 BorderBrush="#3A3D4A" BorderThickness="1"
                                                 Height="24" Text="0"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="B" FontSize="10" Foreground="#8890A0" />
                                        <TextBox x:Name="PART_BBox" FontSize="12"
                                                 Background="#2A2D3A" Foreground="#E0E0F0"
                                                 BorderBrush="#3A3D4A" BorderThickness="1"
                                                 Height="24" Text="0"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="A" FontSize="10" Foreground="#8890A0" />
                                        <TextBox x:Name="PART_ABox" FontSize="12"
                                                 Background="#2A2D3A" Foreground="#E0E0F0"
                                                 BorderBrush="#3A3D4A" BorderThickness="1"
                                                 Height="24" Text="255"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <ItemsControl x:Name="PART_Presets"
                                          Margin="0,8,0,4"
                                          Visibility="{Binding ShowPresets, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="20" ItemHeight="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="16" Height="16"
                                                Margin="2"
                                                Cursor="Hand"
                                                Focusable="False"
                                                ToolTip="{Binding ., Converter={x:Static converters:ColorToHexConverter.Instance}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding ., Converter={x:Static converters:ColorToBrushConverter.Instance}}"
                                                            CornerRadius="2"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#667788" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <Button x:Name="PART_CancelButton"
                                        Content="Cancel" Width="72" Height="28"
                                        FontSize="12" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#2A2D3A"
                                                    BorderBrush="#3A3D4A"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Name="border">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background" Value="#3A3D4A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_OkButton"
                                        Content="OK" Width="72" Height="28"
                                        FontSize="12" Margin="8,0,0,0"
                                        Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#4A90D9"
                                                    CornerRadius="4"
                                                    Name="border">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background" Value="#5AA0E9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="PlotAreaBackground" Value="Black" />
        <Setter Property="PlotAreaBorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Chart}">
                    <Border x:Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_ChartGrid">
                            <!-- 5列 -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 6行 -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: 图表标题 -->
                            <TextBlock x:Name="PART_Title"
                                       Grid.Row="0"
                                       Grid.Column="2"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,2,4,6"
                                       Foreground="#FFE0E0E0"
                                       Text="{TemplateBinding Title}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <!-- Row 1: ExternalTop 图例 -->
                            <!-- Row 2: 左上角 + 顶部坐标轴 + 右上角 -->
                            <!-- 左上角补线 -->
                            <Grid x:Name="PART_CornerTopLeft"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{TemplateBinding TopLeftCornerBrush}" />
                            </Grid>
                            <!-- 顶部坐标轴 -->
                            <axesControls:AxisItemsControl x:Name="PART_TopAxesPresenter"
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding TopXAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Top" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>
                            <!-- 右上角补线 -->
                            <Grid x:Name="PART_CornerTopRight"
                                  Grid.Row="2"
                                  Grid.Column="3"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="{TemplateBinding TopRightCornerBrush}" />
                            </Grid>

                            <!-- Row 3: 核心绘图行 -->
                            <!-- ExternalLeft -->
                            <!-- Left Y Axes -->
                            <axesControls:AxisItemsControl x:Name="PART_LeftAxesPresenter"
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding LeftYAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Left" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>

                            <!-- Plot Area 区域 - 重叠多个元素 -->
                            <!-- Plot Border -->
                            <Border x:Name="PART_PlotAreaBorder"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Background="{TemplateBinding PlotAreaBackground}"
                                    BorderBrush="{TemplateBinding PlotAreaBorderBrush}"
                                    BorderThickness="{TemplateBinding PlotAreaBorderThickness}" />
                            <!-- Grid Lines -->
                            <axesControls:GridLinesControl x:Name="PART_GridLines"
                                                        Grid.Row="3"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        XAxes="{Binding XAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                        YAxes="{Binding YAxes, RelativeSource={RelativeSource TemplatedParent}}" />
                            <!-- Drawing Surface -->
                            <vortice:DrawingSurface x:Name="PART_Surface"
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Stretch="Fill"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                            <!-- Software Surface -->
                            <Image x:Name="PART_SoftwareSurface"
                                   Grid.Row="3"
                                   Grid.Column="2"
                                   Stretch="Fill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                            <!-- Error Overlay -->
                            <Border x:Name="PART_ErrorOverlay"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="12"
                                    Padding="10"
                                    Background="#AA3A0000"
                                    BorderBrush="#CCFF8080"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock MaxWidth="360"
                                           Foreground="#FFFFC8C8"
                                           TextWrapping="Wrap"
                                           Text="{TemplateBinding RenderError}" />
                            </Border>
                            <!-- Annotations -->
                            <annotations:AnnotationsPanel x:Name="PART_AnnotationsPanel"
                                                          Grid.Row="3"
                                                          Grid.Column="2"
                                                          Annotations="{Binding Annotations, RelativeSource={RelativeSource TemplatedParent}}"
                                                          XAxes="{Binding XAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                          YAxes="{Binding YAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Panel.ZIndex="9"
                                                          IsHitTestVisible="True"
                                                          Background="Transparent" />
                            <!-- Modifier Overlay -->
                            <Canvas x:Name="PART_ModifierOverlay"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Panel.ZIndex="8"
                                    IsHitTestVisible="False" />

                            <!-- 内部图例 3x3 Grid -->
                            <Grid x:Name="PART_InternalLegendGrid"
                                  Grid.Row="3"
                                  Grid.Column="2"
                                  Panel.ZIndex="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- Right Y Axes -->
                            <axesControls:AxisItemsControl x:Name="PART_RightAxesPresenter"
                                                        Grid.Row="3"
                                                        Grid.Column="3"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding RightYAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Right" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>

                            <!-- Row 4: 左下角 + 底部坐标轴 + 右下角 -->
                            <!-- 左下角补线 -->
                            <Grid x:Name="PART_CornerBottomLeft"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{TemplateBinding BottomLeftCornerBrush}" />
                            </Grid>
                            <!-- 底部坐标轴 -->
                            <axesControls:AxisItemsControl x:Name="PART_BottomAxesPresenter"
                                                        Grid.Row="4"
                                                        Grid.Column="2"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding BottomXAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Bottom" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>
                            <!-- 右下角补线 -->
                            <Grid x:Name="PART_CornerBottomRight"
                                  Grid.Row="4"
                                  Grid.Column="3"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{TemplateBinding BottomRightCornerBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasRenderError" Value="True">
                            <Setter TargetName="PART_ErrorOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>