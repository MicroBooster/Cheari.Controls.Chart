<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Cheari.Controls"
                    xmlns:legend="clr-namespace:Cheari.Controls.Legend"
                    xmlns:annotations="clr-namespace:Cheari.Controls.Annotations"
                    xmlns:axesControls="clr-namespace:Cheari.Controls.Axes.Controls"
                    xmlns:vortice="clr-namespace:Vortice.Wpf;assembly=Vortice.Wpf">

    <Style TargetType="{x:Type axesControls:AxisControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type axesControls:AxisControl}">
                    <Grid x:Name="PART_Root" ClipToBounds="True">
                        <Border x:Name="PART_TitleHost" Background="Transparent">
                            <TextBlock x:Name="PART_Title"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Canvas x:Name="PART_ContentHost" ClipToBounds="True">
                            <Line x:Name="PART_AxisLine" SnapsToDevicePixels="True" />
                            <Canvas x:Name="PART_TickHost" ClipToBounds="True" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type legend:LegendControl}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type legend:LegendControl}">
                    <Border x:Name="PART_LegendBorder"
                            Background="#CC1A1A2E"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            Padding="6">
                        <StackPanel x:Name="PART_ItemsHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="PlotAreaBackground" Value="Black" />
        <Setter Property="PlotAreaBorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Chart}">
                    <Border x:Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_ChartGrid">
                            <!-- 5列 -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 6行 -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: 标题区 -->

                            <!-- Row 1: ExternalTop 图例 -->
                            <!-- Row 2: 左上角 + 顶部坐标轴 + 右上角 -->
                            <!-- 左上角补线 -->
                            <Grid x:Name="PART_CornerTopLeft"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding TopLeftCornerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                            <!-- 顶部坐标轴 -->
                            <axesControls:AxisItemsControl x:Name="PART_TopAxesPresenter"
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding TopXAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Top" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>
                            <!-- 右上角补线 -->
                            <Grid x:Name="PART_CornerTopRight"
                                  Grid.Row="2"
                                  Grid.Column="3"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding TopRightCornerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>

                            <!-- Row 3: 核心绘图行 -->
                            <!-- ExternalLeft -->
                            <!-- Left Y Axes -->
                            <axesControls:AxisItemsControl x:Name="PART_LeftAxesPresenter"
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding LeftYAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Left" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>

                            <!-- Plot Area 区域 - 重叠多个元素 -->
                            <!-- Plot Border -->
                            <Border x:Name="PART_PlotAreaBorder"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Background="{TemplateBinding PlotAreaBackground}"
                                    BorderBrush="{TemplateBinding PlotAreaBorderBrush}"
                                    BorderThickness="{TemplateBinding PlotAreaBorderThickness}" />
                            <!-- Grid Lines -->
                            <axesControls:GridLinesControl x:Name="PART_GridLines"
                                                        Grid.Row="3"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        XAxes="{Binding XAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                        YAxes="{Binding YAxes, RelativeSource={RelativeSource TemplatedParent}}" />
                            <!-- Drawing Surface -->
                            <vortice:DrawingSurface x:Name="PART_Surface"
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Stretch="Fill"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                            <!-- Software Surface -->
                            <Image x:Name="PART_SoftwareSurface"
                                   Grid.Row="3"
                                   Grid.Column="2"
                                   Stretch="Fill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                            <!-- Error Overlay -->
                            <Border x:Name="PART_ErrorOverlay"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="12"
                                    Padding="10"
                                    Background="#AA3A0000"
                                    BorderBrush="#CCFF8080"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock MaxWidth="360"
                                           Foreground="#FFFFC8C8"
                                           TextWrapping="Wrap"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RenderError}" />
                            </Border>
                            <!-- Annotations -->
                            <annotations:AnnotationsPanel x:Name="PART_AnnotationsPanel"
                                                          Grid.Row="3"
                                                          Grid.Column="2"
                                                          Annotations="{Binding Annotations, RelativeSource={RelativeSource TemplatedParent}}"
                                                          XAxes="{Binding XAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                          YAxes="{Binding YAxes, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Panel.ZIndex="9"
                                                          IsHitTestVisible="True"
                                                          Background="Transparent" />
                            <!-- Modifier Overlay -->
                            <Canvas x:Name="PART_ModifierOverlay"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Panel.ZIndex="8"
                                    IsHitTestVisible="False" />

                            <!-- 内部图例 3x3 Grid -->
                            <Grid x:Name="PART_InternalLegendGrid"
                                  Grid.Row="3"
                                  Grid.Column="2"
                                  Panel.ZIndex="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- Right Y Axes -->
                            <axesControls:AxisItemsControl x:Name="PART_RightAxesPresenter"
                                                        Grid.Row="3"
                                                        Grid.Column="3"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding RightYAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Right" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>

                            <!-- Row 4: 左下角 + 底部坐标轴 + 右下角 -->
                            <!-- 左下角补线 -->
                            <Grid x:Name="PART_CornerBottomLeft"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{Binding BottomLeftCornerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                            <!-- 底部坐标轴 -->
                            <axesControls:AxisItemsControl x:Name="PART_BottomAxesPresenter"
                                                        Grid.Row="4"
                                                        Grid.Column="2"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        ItemsSource="{Binding BottomXAxes, RelativeSource={RelativeSource TemplatedParent}}">
                                <axesControls:AxisItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <axesControls:AxisPanel AxisPlacement="Bottom" />
                                    </ItemsPanelTemplate>
                                </axesControls:AxisItemsControl.ItemsPanel>
                            </axesControls:AxisItemsControl>
                            <!-- 右下角补线 -->
                            <Grid x:Name="PART_CornerBottomRight"
                                  Grid.Row="4"
                                  Grid.Column="3"
                                  Panel.ZIndex="1"
                                  IsHitTestVisible="False"
                                  Background="Transparent">
                                <Border Width="1"
                                        Height="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{Binding BottomRightCornerBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasRenderError" Value="True">
                            <Setter TargetName="PART_ErrorOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>