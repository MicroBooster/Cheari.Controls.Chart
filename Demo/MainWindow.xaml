<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        Title="Cheari Charts · 图表控件演示"
        Height="720" Width="1280"
        MinHeight="500" MinWidth="900"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#161B22" />
        <SolidColorBrush x:Key="SidebarBorder" Color="#21262D" />
        <SolidColorBrush x:Key="SidebarHoverBg" Color="#1C2533" />
        <SolidColorBrush x:Key="SidebarActiveBg" Color="#1F3A5F" />
        <SolidColorBrush x:Key="SidebarActiveBorder" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondary" Color="#848D97" />
        <SolidColorBrush x:Key="TextDim" Color="#484F58" />
        <SolidColorBrush x:Key="SectionHeaderColor" Color="#6E7681" />

        <Style x:Key="SidebarSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SectionHeaderColor}" />
            <Setter Property="Margin" Value="16,14,12,4" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="SidebarNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="16,8,12,8"
                                Margin="4,1,8,1"
                                CornerRadius="0,6,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Content.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Content.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarActiveBg}" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource SidebarActiveBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarListView" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarNavItem}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="16,20,12,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25C6;" FontSize="20" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="Cheari Charts" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="WPF 高性能图表控件库" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="30,2,0,0" />
                </StackPanel>

                <!-- Navigation Sections -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Home -->
                        <Border Padding="0,0,0,2">
                            <Border x:Name="HomeNavItem"
                                    Background="Transparent"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="Transparent"
                                    Padding="16,10,12,10"
                                    Margin="4,2,8,2"
                                    CornerRadius="0,6,6,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HomeNavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2302;" FontSize="16"
                                               Foreground="{StaticResource AccentBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="首页概览" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Border>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="基础图表" />
                        <ListBox x:Name="BasicChartsList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="LineChartView">
                                <local:NavItem Icon="&#x2014;" Title="折线图" />
                            </ListBoxItem>
                            <ListBoxItem Tag="ScatterChartView">
                                <local:NavItem Icon="&#x25CF;" Title="散点图" />
                            </ListBoxItem>
                            <ListBoxItem Tag="BarChartView">
                                <local:NavItem Icon="&#x25A0;" Title="柱状图" />
                            </ListBoxItem>
                            <ListBoxItem Tag="AreaChartView">
                                <local:NavItem Icon="&#x25B2;" Title="面积图" />
                            </ListBoxItem>
                            <ListBoxItem Tag="OhlcChartView">
                                <local:NavItem Icon="&#x25C6;" Title="蜡烛图" />
                            </ListBoxItem>
                            <ListBoxItem Tag="DataReuseDemoView">
                                <local:NavItem Icon="&#x21CC;" Title="数据复用" />
                            </ListBoxItem>
                            <ListBoxItem Tag="FinancialChartView">
                                <local:NavItem Icon="&#x2666;" Title="金融图表" />
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="高级功能" />
                        <ListBox x:Name="AdvancedChartsList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="LegendDemoView">
                                <local:NavItem Icon="&#x2261;" Title="图例演示" />
                            </ListBoxItem>
                            <ListBoxItem Tag="RangePaddingDemoView">
                                <local:NavItem Icon="&#x2194;" Title="坐标轴留白" />
                            </ListBoxItem>
                            <ListBoxItem Tag="InteractionDemoView">
                                <local:NavItem Icon="&#x263C;" Title="交互修饰器" />
                            </ListBoxItem>
                            <ListBoxItem Tag="AxisShowcaseView">
                                <local:NavItem Icon="&#x2B9F;" Title="四轴演示" />
                            </ListBoxItem>
                            <ListBoxItem Tag="MultiAxisView">
                                <local:NavItem Icon="&#x25E6;" Title="多轴" />
                            </ListBoxItem>
                            <ListBoxItem Tag="LogAxisView">
                                <local:NavItem Icon="&#x221E;" Title="对数轴" />
                            </ListBoxItem>
                            <ListBoxItem Tag="FifoChartView">
                                <local:NavItem Icon="&#x25B6;" Title="FIFO 实时" />
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="外观与导出" />
                        <ListBox x:Name="AppearanceList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="ThemeCustomizationView">
                                <local:NavItem Icon="&#x2630;" Title="主题定制" />
                            </ListBoxItem>
                            <ListBoxItem Tag="DataExportView">
                                <local:NavItem Icon="&#x21E7;" Title="数据导出" />
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="渲染后端" />
                        <ListBox x:Name="RendererList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="SoftwareBackendView">
                                <local:NavItem Icon="&#x25D0;" Title="强制软件" />
                            </ListBoxItem>
                            <ListBoxItem Tag="HardwareOnlyDiagnosticsView">
                                <local:NavItem Icon="&#x2699;" Title="硬件诊断" />
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="综合验证" />
                        <ListBox x:Name="VerificationList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="ComprehensiveVerificationView">
                                <local:NavItem Icon="&#x2714;" Title="五项全开验证" />
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="性能测试" />
                        <ListBox x:Name="PerfList" Style="{StaticResource SidebarListView}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="StressTestView">
                                <local:NavItem Icon="&#x26A1;" Title="极限压测" />
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#0D1117" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                    <TextBlock Text="Cheari.Controls.Chart v1.0" FontSize="10" Foreground="{StaticResource TextDim}" />
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="{StaticResource SidebarBorder}" />

        <!-- Content Area -->
        <Border Grid.Column="2" Background="#0D1117">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ContentControl prism:RegionManager.RegionName="ContentRegion" />
            </Grid>
        </Border>
    </Grid>
</Window>
