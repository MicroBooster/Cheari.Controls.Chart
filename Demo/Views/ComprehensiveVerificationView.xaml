<UserControl x:Class="Demo.Views.ComprehensiveVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chart="http://schemas.cheari.com/controls"
             xmlns:local="clr-namespace:Demo.Views"
             Background="#0D1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="2" Rows="3" Margin="6">

                <!-- Line Chart -->
                <Border Margin="4" Background="#1A2238" BorderBrush="#49576E" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#21262D" Padding="8,5" CornerRadius="4,4,0,0"
                                BorderBrush="#49576E" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2014;" FontSize="12" Foreground="#58A6FF" VerticalAlignment="Center" />
                                <TextBlock Text=" 折线图 (Damped Sin)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E6EDF3" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <chart:Chart Grid.Row="1"
                                     Background="#1A2238" PlotAreaBackground="#05070B"
                                     XAxes="{Binding LineXAxes}" YAxes="{Binding LineYAxes}"
                                     Series="{Binding LineSeries}" Modifiers="{Binding LineModifiers}"
                                     EnableAntialiasing="{Binding EnableAntialiasing}" ShowFps="True"
                                     Height="180" />
                    </Grid>
                </Border>

                <!-- Scatter Chart -->
                <Border Margin="4" Background="#1A2238" BorderBrush="#49576E" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#21262D" Padding="8,5" CornerRadius="4,4,0,0"
                                BorderBrush="#49576E" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25CF;" FontSize="12" Foreground="#FFA500" VerticalAlignment="Center" />
                                <TextBlock Text=" 散点图 (Random)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E6EDF3" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <chart:Chart Grid.Row="1"
                                     Background="#1A2238" PlotAreaBackground="#05070B"
                                     XAxes="{Binding ScatterXAxes}" YAxes="{Binding ScatterYAxes}"
                                     Series="{Binding ScatterSeries}" Modifiers="{Binding ScatterModifiers}"
                                     EnableAntialiasing="{Binding EnableAntialiasing}" ShowFps="True"
                                     Height="180" />
                    </Grid>
                </Border>

                <!-- Bar Chart -->
                <Border Margin="4" Background="#1A2238" BorderBrush="#49576E" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#21262D" Padding="8,5" CornerRadius="4,4,0,0"
                                BorderBrush="#49576E" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25A0;" FontSize="12" Foreground="#4682E6" VerticalAlignment="Center" />
                                <TextBlock Text=" 柱状图 (Live Bars)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E6EDF3" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <chart:Chart Grid.Row="1"
                                     Background="#1A2238" PlotAreaBackground="#05070B"
                                     XAxes="{Binding BarXAxes}" YAxes="{Binding BarYAxes}"
                                     Series="{Binding BarSeries}" Modifiers="{Binding BarModifiers}"
                                     EnableAntialiasing="{Binding EnableAntialiasing}" ShowFps="True"
                                     Height="180" />
                    </Grid>
                </Border>

                <!-- Area Chart -->
                <Border Margin="4" Background="#1A2238" BorderBrush="#49576E" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#21262D" Padding="8,5" CornerRadius="4,4,0,0"
                                BorderBrush="#49576E" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B2;" FontSize="12" Foreground="#32CD32" VerticalAlignment="Center" />
                                <TextBlock Text=" 面积图 (Decay Cos)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E6EDF3" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <chart:Chart Grid.Row="1"
                                     Background="#1A2238" PlotAreaBackground="#05070B"
                                     XAxes="{Binding AreaXAxes}" YAxes="{Binding AreaYAxes}"
                                     Series="{Binding AreaSeries}" Modifiers="{Binding AreaModifiers}"
                                     EnableAntialiasing="{Binding EnableAntialiasing}" ShowFps="True"
                                     Height="180" />
                    </Grid>
                </Border>

                <!-- OHLC Chart (Occupation: 2 cells in 2x3 grid = 1 placeholder + 1 OHLC) -->
                <Border Margin="4" Background="#1A2238" BorderBrush="#49576E" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#21262D" Padding="8,5" CornerRadius="4,4,0,0"
                                BorderBrush="#49576E" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25C6;" FontSize="12" Foreground="#00C853" VerticalAlignment="Center" />
                                <TextBlock Text=" 蜡烛图 (Live OHLC)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E6EDF3" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <chart:Chart Grid.Row="1"
                                     Background="#1A2238" PlotAreaBackground="#05070B"
                                     XAxes="{Binding OhlcXAxes}" YAxes="{Binding OhlcYAxes}"
                                     Series="{Binding OhlcSeries}" Modifiers="{Binding OhlcModifiers}"
                                     EnableAntialiasing="{Binding EnableAntialiasing}" ShowFps="True"
                                     Height="180" />
                    </Grid>
                </Border>

            </UniformGrid>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Border Grid.Row="1" Background="#2D3748" BorderBrush="#49576E" BorderThickness="0,1,0,0">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center"
                           Text="综合验证 | 5种曲线同时流式推送，验证缓存优化后无闪烁抖动，所有图表正常渲染"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <CheckBox Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"
                              Content="抗锯齿" IsChecked="{Binding EnableAntialiasing}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
