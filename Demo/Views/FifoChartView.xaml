<local:ChartDemoViewBase x:Class="Demo.Views.FifoChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chart="http://schemas.cheari.com/controls"
             xmlns:local="clr-namespace:Demo.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <chart:Chart x:Name="DemoChart" Grid.Row="0"
                         Background="#1A2238" BorderBrush="#49576E" BorderThickness="0"
                         PlotAreaBackground="#05070B" PlotAreaBorderBrush="#5E708A" PlotAreaBorderThickness="0"
                         Series="{Binding Series}"
                         Modifiers="{Binding Modifiers}"
                         EnableAntialiasing="{Binding EnableAntialiasing}"
                         ShowFps="True">
                <chart:Chart.XAxes>
                    <chart:LinearAxis Id="DefaultXAxis"
                                      Placement="Bottom"
                                      VisibleRange="0,10"
                                      AutoRange="True"
                                      AlignRangeToTicks="True"
                                      Title="Time (s)"
                                      LabelFormat="F1"
                                      ShowMajorGridLines="True"
                                      ShowMinorGridLines="True"
                                      MajorGridLineThickness="1"
                                      MinorGridLineThickness="1"
                                      MinorGridLineDashArray="2,4" />
                </chart:Chart.XAxes>
                <chart:Chart.YAxes>
                    <chart:LinearAxis Id="DefaultYAxis"
                                      Placement="Left"
                                      VisibleRange="-1.6,1.6"
                                      AutoRange="True"
                                      AlignRangeToTicks="True"
                                      Title="Amplitude"
                                      LabelFormat="F2"
                                      ShowMajorGridLines="True"
                                      ShowMinorGridLines="True"
                                      MajorGridLineThickness="1"
                                      MinorGridLineThickness="1"
                                      MinorGridLineDashArray="2,4" />
                </chart:Chart.YAxes>
            </chart:Chart>
            <Border Grid.Row="1" Background="#2D3748" BorderBrush="#49576E" BorderThickness="0,1,0,0">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center" Text="{Binding Description}" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <CheckBox Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White" Content="抗锯齿" IsChecked="{Binding EnableAntialiasing}" />
                        <TextBlock Margin="20,0,0,0" Foreground="#00FF00" VerticalAlignment="Center"
                                   Text="{Binding ElementName=DemoChart, Path=Fps, StringFormat=FPS:{0:F1}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#2D3748" BorderBrush="#49576E" BorderThickness="1,0,0,0" Padding="15">
            <StackPanel>
                <TextBlock Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,0,0,15">FIFO 参数设置</TextBlock>
                
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5">FIFO 容量 (0=无限)</TextBlock>
                    <Slider Minimum="0" Maximum="2000" Value="{Binding FifoCapacity}" SmallChange="10" LargeChange="100" />
                    <TextBlock Foreground="#888888" FontSize="11" TextAlignment="Right" Text="{Binding FifoCapacity}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5">更新间隔 (ms)</TextBlock>
                    <Slider Minimum="5" Maximum="100" Value="{Binding UpdateInterval}" SmallChange="1" LargeChange="10" />
                    <TextBlock Foreground="#888888" FontSize="11" TextAlignment="Right"><Run Text="{Binding UpdateInterval}" /><Run Text=" ms" /></TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5">频率</TextBlock>
                    <Slider Minimum="1" Maximum="50" Value="{Binding Frequency}" SmallChange="0.5" LargeChange="5" />
                    <TextBlock Foreground="#888888" FontSize="11" TextAlignment="Right" Text="{Binding Frequency, StringFormat=F1}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5">衰减系数</TextBlock>
                    <Slider Minimum="0" Maximum="0.1" Value="{Binding Decay}" SmallChange="0.001" LargeChange="0.01" />
                    <TextBlock Foreground="#888888" FontSize="11" TextAlignment="Right" Text="{Binding Decay, StringFormat=F3}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <CheckBox Foreground="White" Content="运行" IsChecked="{Binding IsRunning}" />
                </StackPanel>

                <Button Content="重置数据" Width="100" Height="30" Margin="0,0,0,5"
                        Command="{Binding ResetCommand}"
                        Background="#4A5568" Foreground="White" BorderBrush="#5E708A" />
            </StackPanel>
        </Border>
    </Grid>
</local:ChartDemoViewBase>
