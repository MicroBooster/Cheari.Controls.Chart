<UserControl x:Class="Demo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demo.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="#E6EDF3"
                           Text="Cheari.Controls.Chart" FontFamily="Segoe UI" />
                <TextBlock FontSize="14" Foreground="#848D97" Margin="0,4,0,0"
                           Text="WPF 高性能图表控件库 · D3D11 硬件加速 · 支持 5 大图表类型" />
                <Border Height="1" Background="#21262D" Margin="0,16,0,8" />
            </StackPanel>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding ChartTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Height="140" Margin="0,0,12,12"
                                CornerRadius="8" Cursor="Hand"
                                Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                MouseLeftButtonDown="CardClicked"
                                Tag="{Binding ViewName}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#161B22" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A2332" />
                                            <Setter Property="BorderBrush" Value="#58A6FF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="14,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock FontSize="22" Text="{Binding Icon}" VerticalAlignment="Center" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3"
                                               Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" FontSize="12" Foreground="#848D97"
                                           Text="{Binding Description}" TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
