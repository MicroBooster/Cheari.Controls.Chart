<local:ChartDemoViewBase x:Class="Demo.Views.LegendDemoView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chart="http://schemas.cheari.com/controls"
                    xmlns:legend="http://schemas.cheari.com/controls/legend"
                    xmlns:local="clr-namespace:Demo.Views"
                    xmlns:conv="clr-namespace:Demo.Converters">

    <local:ChartDemoViewBase.Resources>
        <conv:PositionEqualityConverter x:Key="PositionEqualityConverter" />
        <conv:OrientationEqualityConverter x:Key="OrientationEqualityConverter" />
        <conv:HAlignEqualityConverter x:Key="HAlignEqualityConverter" />
        <conv:VAlignEqualityConverter x:Key="VAlignEqualityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:VisibilityIndicatorConverter x:Key="VisibilityIndicatorConverter" />
        <SolidColorBrush x:Key="PanelBg" Color="#161B22" />
        <SolidColorBrush x:Key="PanelBorder" Color="#21262D" />
        <SolidColorBrush x:Key="CardBg" Color="#0D1117" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondary" Color="#848D97" />
        <SolidColorBrush x:Key="TextDim" Color="#484F58" />
        <SolidColorBrush x:Key="SectionAccent" Color="#30363D" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ConfigLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RadioCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="14"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                Padding="2" Width="48">
                            <Border x:Name="Thumb" CornerRadius="10"
                                    Width="20" Height="20"
                                    Background="{StaticResource TextDim}"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </local:ChartDemoViewBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Chart Area -->
        <Border Grid.Column="0" Background="#0A0E13" CornerRadius="8" Margin="10">
            <chart:Chart x:Name="DemoChart"
                         Background="Transparent"
                         BorderBrush="Transparent" BorderThickness="0"
                         PlotAreaBackground="#020408"
                         PlotAreaBorderBrush="#1E2430"
                         PlotAreaBorderThickness="1"
                         XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                         Series="{Binding Series}"
                         Modifiers="{Binding Modifiers}"
                         EnableAntialiasing="{Binding EnableAntialiasing}"
                         ShowFps="False">
                <chart:Chart.Legend>
                    <legend:LegendControl x:Name="LegendControl"
                                           Position="{Binding SelectedPosition}"
                                           Orientation="{Binding SelectedOrientation}"
                                           HorizontalAlignment="{Binding SelectedHAlign}"
                                           VerticalAlignment="{Binding SelectedVAlign}" />
                </chart:Chart.Legend>
            </chart:Chart>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Control Panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource PanelBg}">
            <StackPanel Margin="14,14">

                <!-- Header -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="图例演示" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="演示图例的位置、方向、系列可见性等全部功能"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Legend Position -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="图例位置" />
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource ConfigLabel}" Text="图表内部（覆盖在绘图区上）" />
                    <WrapPanel Margin="0,0,0,6">
                        <RadioButton GroupName="Position"
                                     Content="上方" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=InternalTop}" />
                        <RadioButton GroupName="Position"
                                     Content="下方" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=InternalBottom}" />
                        <RadioButton GroupName="Position"
                                     Content="左侧" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=InternalLeft}" />
                        <RadioButton GroupName="Position"
                                     Content="右侧" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=InternalRight}" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource ConfigLabel}" Text="图表外部（独立布局区域）" />
                    <WrapPanel>
                        <RadioButton GroupName="Position"
                                     Content="外上方" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=ExternalTop}" />
                        <RadioButton GroupName="Position"
                                     Content="外下方" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=ExternalBottom}" />
                        <RadioButton GroupName="Position"
                                     Content="外左侧" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=ExternalLeft}" />
                        <RadioButton GroupName="Position"
                                     Content="外右侧" Style="{StaticResource RadioCard}"
                                     IsChecked="{Binding SelectedPosition, Converter={StaticResource PositionEqualityConverter}, ConverterParameter=ExternalRight}" />
                    </WrapPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Legend Orientation -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="排列方向" />
                <WrapPanel Margin="0,0,0,12">
                    <RadioButton GroupName="Orientation"
                                 Content="垂直排列" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedOrientation, Converter={StaticResource OrientationEqualityConverter}, ConverterParameter=Vertical}" />
                    <RadioButton GroupName="Orientation"
                                 Content="水平排列" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedOrientation, Converter={StaticResource OrientationEqualityConverter}, ConverterParameter=Horizontal}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Alignment -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="对齐方式" />
                <TextBlock Style="{StaticResource ConfigLabel}" Text="水平对齐" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="HAlign"
                                 Content="Left" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedHAlign, Converter={StaticResource HAlignEqualityConverter}, ConverterParameter=Left}" />
                    <RadioButton GroupName="HAlign"
                                 Content="Center" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedHAlign, Converter={StaticResource HAlignEqualityConverter}, ConverterParameter=Center}" />
                    <RadioButton GroupName="HAlign"
                                 Content="Right" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedHAlign, Converter={StaticResource HAlignEqualityConverter}, ConverterParameter=Right}" />
                    <RadioButton GroupName="HAlign"
                                 Content="Stretch" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedHAlign, Converter={StaticResource HAlignEqualityConverter}, ConverterParameter=Stretch}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource ConfigLabel}" Text="垂直对齐" />
                <WrapPanel Margin="0,0,0,12">
                    <RadioButton GroupName="VAlign"
                                 Content="Top" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedVAlign, Converter={StaticResource VAlignEqualityConverter}, ConverterParameter=Top}" />
                    <RadioButton GroupName="VAlign"
                                 Content="Center" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedVAlign, Converter={StaticResource VAlignEqualityConverter}, ConverterParameter=Center}" />
                    <RadioButton GroupName="VAlign"
                                 Content="Bottom" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedVAlign, Converter={StaticResource VAlignEqualityConverter}, ConverterParameter=Bottom}" />
                    <RadioButton GroupName="VAlign"
                                 Content="Stretch" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedVAlign, Converter={StaticResource VAlignEqualityConverter}, ConverterParameter=Stretch}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Anti-aliasing -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="渲染选项" />
                <StackPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource InfoChip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="抗锯齿"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding EnableAntialiasing}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Legend Items Preview -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="图例条目 · 点击切换可见性" />
                <ItemsControl ItemsSource="{Binding LegendInstance.Items}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InfoChip}" Cursor="Hand"
                                    MouseLeftButtonDown="LegendChip_Clicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Fill="{Binding Stroke, Converter={StaticResource ColorToBrushConverter}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Grid.Column="3" Text="{Binding IsVisible, Converter={StaticResource VisibilityIndicatorConverter}}"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDim}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- FPS -->
                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="实时帧率"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#4CAF50" VerticalAlignment="Center"
                                   Text="{Binding ElementName=DemoChart, Path=Fps, StringFormat={}{0:F1} FPS}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:ChartDemoViewBase>
