<local:ChartDemoViewBase x:Class="Demo.Views.LogRangePaddingDemoView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chart="http://schemas.cheari.com/controls"
                    xmlns:local="clr-namespace:Demo.Views"
                    xmlns:conv="clr-namespace:Demo.Converters">

    <local:ChartDemoViewBase.Resources>
        <conv:LogChartTypeEqualityConverter x:Key="LogChartTypeEqualityConverter" />
        <conv:LimitModeEqualityConverter x:Key="LimitModeEqualityConverter" />

        <SolidColorBrush x:Key="PanelBg" Color="#161B22" />
        <SolidColorBrush x:Key="PanelBorder" Color="#21262D" />
        <SolidColorBrush x:Key="CardBg" Color="#0D1117" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondary" Color="#848D97" />
        <SolidColorBrush x:Key="TextDim" Color="#484F58" />
        <SolidColorBrush x:Key="SectionAccent" Color="#30363D" />
        <SolidColorBrush x:Key="AxisXColor" Color="#4FC3F7" />
        <SolidColorBrush x:Key="AxisYColor" Color="#CE93D8" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ConfigLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PaddingSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="14"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                Padding="2" Width="48">
                            <Border x:Name="Thumb" CornerRadius="10"
                                    Width="20" Height="20"
                                    Background="{StaticResource TextDim}"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadioCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3A5F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D2A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </local:ChartDemoViewBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Chart Area -->
        <Border Grid.Column="0" Background="#0A0E13" CornerRadius="8" Margin="10">
            <chart:Chart x:Name="DemoChart"
                         Background="Transparent"
                         BorderBrush="Transparent" BorderThickness="0"
                         PlotAreaBackground="#020408"
                         PlotAreaBorderBrush="#1E2430"
                         PlotAreaBorderThickness="1"
                         PlotAreaMargin="{Binding PlotAreaMargin}"
                         XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                         Series="{Binding Series}"
                         Modifiers="{Binding Modifiers}"
                         EnableAntialiasing="{Binding EnableAntialiasing}"
                         ShowFps="False" />
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Control Panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource PanelBg}">
            <StackPanel Margin="14,14">

                <!-- Header -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="对数轴留白演示" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="验证 Chart.PlotAreaMargin 视口裁剪留白功能，支持 4 种曲线实时切换"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Chart Type Selector -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="曲线类型" />
                <WrapPanel Margin="0,0,0,12">
                    <RadioButton GroupName="ChartType"
                                 Content="折线图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource LogChartTypeEqualityConverter}, ConverterParameter=Line}" />
                    <RadioButton GroupName="ChartType"
                                 Content="散点图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource LogChartTypeEqualityConverter}, ConverterParameter=Scatter}" />
                    <RadioButton GroupName="ChartType"
                                 Content="柱状图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource LogChartTypeEqualityConverter}, ConverterParameter=Bar}" />
                    <RadioButton GroupName="ChartType"
                                 Content="面积图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource LogChartTypeEqualityConverter}, ConverterParameter=Area}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- 左边距 / 右边距 -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="绘图区水平外边距" Foreground="{StaticResource AxisXColor}" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="左侧（Left）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding PlotAreaMarginLeft, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding PlotAreaMarginLeft, StringFormat='当前值：{0:F0}px'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="右侧（Right）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding PlotAreaMarginRight, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding PlotAreaMarginRight, StringFormat='当前值：{0:F0}px'}" />
                </Border>

                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X 轴 AutoRange"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding XAutoRange}" />
                    </Grid>
                </Border>

                <!-- X-Axis VisibleRangeLimit -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="X 轴范围限制" Foreground="{StaticResource AxisXColor}" Margin="0,12,0,8" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最小限制（Min）" />
                <Slider Minimum="0.5" Maximum="200" SmallChange="1" LargeChange="10"
                        TickFrequency="25" Height="28" Margin="0,0,0,6"
                        Value="{Binding XLimitMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XLimitMin, StringFormat='当前值：{0:F1}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最大限制（Max）" />
                <Slider Minimum="0.5" Maximum="200" SmallChange="1" LargeChange="10"
                        TickFrequency="25" Height="28" Margin="0,0,0,6"
                        Value="{Binding XLimitMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XLimitMax, StringFormat='当前值：{0:F1}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="限制模式" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="XLimitMode" Content="不限制" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=None}" />
                    <RadioButton GroupName="XLimitMode" Content="最小值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinOnly}" />
                    <RadioButton GroupName="XLimitMode" Content="最大值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MaxOnly}" />
                    <RadioButton GroupName="XLimitMode" Content="全部" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinAndMax}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Log Base -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="对数底数（Base）" Foreground="{StaticResource AxisYColor}" />
                <Slider Minimum="1.5" Maximum="20.0" SmallChange="0.5" LargeChange="2.0"
                        TickFrequency="2.0" Height="28" Margin="0,0,0,6"
                        Value="{Binding LogBase, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding LogBase, StringFormat='底数：{0:F1}'}" />
                </Border>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,10,0,0" />

                <!-- 上边距 / 下边距 -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="绘图区垂直外边距" Foreground="{StaticResource AxisYColor}" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="底部（Bottom）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding PlotAreaMarginBottom, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding PlotAreaMarginBottom, StringFormat='当前值：{0:F0}px'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="顶部（Top）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding PlotAreaMarginTop, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding PlotAreaMarginTop, StringFormat='当前值：{0:F0}px'}" />
                </Border>

                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y 轴 AutoRange"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding YAutoRange}" />
                    </Grid>
                </Border>

                <!-- Y-Axis VisibleRangeLimit -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Y 轴范围限制（对数）" Foreground="{StaticResource AxisYColor}" Margin="0,12,0,8" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最小限制（Min）" />
                <Slider Minimum="0.1" Maximum="10000" SmallChange="1" LargeChange="100"
                        TickFrequency="500" Height="28" Margin="0,0,0,6"
                        Value="{Binding YLimitMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YLimitMin, StringFormat='当前值：{0:F1}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最大限制（Max）" />
                <Slider Minimum="0.1" Maximum="50000" SmallChange="1" LargeChange="1000"
                        TickFrequency="5000" Height="28" Margin="0,0,0,6"
                        Value="{Binding YLimitMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YLimitMax, StringFormat='当前值：{0:F1}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="限制模式" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="YLimitMode" Content="不限制" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=None}" />
                    <RadioButton GroupName="YLimitMode" Content="最小值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinOnly}" />
                    <RadioButton GroupName="YLimitMode" Content="最大值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MaxOnly}" />
                    <RadioButton GroupName="YLimitMode" Content="全部" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinAndMax}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Actions -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="快捷操作" />

                <Button Content="↺ 双击图表以执行 ZoomExtents（恢复范围）" Style="{StaticResource ActionButton}"
                        Click="ZoomExtents_Click" />

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Anti-aliasing -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="渲染选项" />
                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="抗锯齿"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding EnableAntialiasing}" />
                    </Grid>
                </Border>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- FPS -->
                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="实时帧率"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#4CAF50" VerticalAlignment="Center"
                                   Text="{Binding ElementName=DemoChart, Path=Fps, StringFormat={}{0:F1} FPS}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:ChartDemoViewBase>
