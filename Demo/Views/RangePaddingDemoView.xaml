<local:ChartDemoViewBase x:Class="Demo.Views.RangePaddingDemoView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chart="http://schemas.cheari.com/controls"
                    xmlns:local="clr-namespace:Demo.Views"
                    xmlns:conv="clr-namespace:Demo.Converters">

    <local:ChartDemoViewBase.Resources>
        <conv:ChartTypeEqualityConverter x:Key="ChartTypeEqualityConverter" />
        <conv:LimitModeEqualityConverter x:Key="LimitModeEqualityConverter" />

        <SolidColorBrush x:Key="PanelBg" Color="#161B22" />
        <SolidColorBrush x:Key="PanelBorder" Color="#21262D" />
        <SolidColorBrush x:Key="CardBg" Color="#0D1117" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondary" Color="#848D97" />
        <SolidColorBrush x:Key="TextDim" Color="#484F58" />
        <SolidColorBrush x:Key="SectionAccent" Color="#30363D" />
        <SolidColorBrush x:Key="AxisXColor" Color="#4FC3F7" />
        <SolidColorBrush x:Key="AxisYColor" Color="#81C784" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ConfigLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PaddingSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1.0" />
            <Setter Property="SmallChange" Value="0.05" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="TickFrequency" Value="0.1" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="14"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                Padding="2" Width="48">
                            <Border x:Name="Thumb" CornerRadius="10"
                                    Width="20" Height="20"
                                    Background="{StaticResource TextDim}"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadioCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3A5F" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SectionAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F3A5F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D2A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </local:ChartDemoViewBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Chart Area -->
        <Border Grid.Column="0" Background="#0A0E13" CornerRadius="8" Margin="10">
            <chart:Chart x:Name="DemoChart"
                         Background="Transparent"
                         BorderBrush="Transparent" BorderThickness="0"
                         PlotAreaBackground="#020408"
                         PlotAreaBorderBrush="#1E2430"
                         PlotAreaBorderThickness="1"
                         XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                         Series="{Binding Series}"
                         Modifiers="{Binding Modifiers}"
                         EnableAntialiasing="{Binding EnableAntialiasing}"
                         ShowFps="False" />
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Control Panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource PanelBg}">
            <StackPanel Margin="14,14">

                <!-- Header -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="坐标轴留白演示" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="演示 AutoRange 与 ZoomExtents 时坐标轴的留白控制，支持 5 种曲线实时切换"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Chart Type Selector -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="曲线类型" />
                <WrapPanel Margin="0,0,0,12">
                    <RadioButton GroupName="ChartType"
                                 Content="折线图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource ChartTypeEqualityConverter}, ConverterParameter=Line}" />
                    <RadioButton GroupName="ChartType"
                                 Content="散点图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource ChartTypeEqualityConverter}, ConverterParameter=Scatter}" />
                    <RadioButton GroupName="ChartType"
                                 Content="柱状图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource ChartTypeEqualityConverter}, ConverterParameter=Bar}" />
                    <RadioButton GroupName="ChartType"
                                 Content="面积图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource ChartTypeEqualityConverter}, ConverterParameter=Area}" />
                    <RadioButton GroupName="ChartType"
                                 Content="蜡烛图" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding SelectedChartType, Converter={StaticResource ChartTypeEqualityConverter}, ConverterParameter=Ohlc}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- X-Axis Padding -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="X 轴留白" Foreground="{StaticResource AxisXColor}" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="左端留白（Min）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding XPaddingMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XPaddingMin, StringFormat='当前值：{0:P0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="右端留白（Max）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding XPaddingMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XPaddingMax, StringFormat='当前值：{0:P0}'}" />
                </Border>

                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X 轴 AutoRange"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding XAutoRange}" />
                    </Grid>
                </Border>

                <!-- X-Axis VisibleRangeLimit -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="X 轴范围限制" Foreground="{StaticResource AxisXColor}" Margin="0,12,0,8" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最小限制（Min）" />
                <Slider Minimum="-200" Maximum="300" SmallChange="1" LargeChange="10"
                        TickFrequency="25" Height="28" Margin="0,0,0,6"
                        Value="{Binding XLimitMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XLimitMin, StringFormat='当前值：{0:F0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最大限制（Max）" />
                <Slider Minimum="-200" Maximum="300" SmallChange="1" LargeChange="10"
                        TickFrequency="25" Height="28" Margin="0,0,0,6"
                        Value="{Binding XLimitMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding XLimitMax, StringFormat='当前值：{0:F0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="限制模式" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="XLimitMode" Content="不限制" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=None}" />
                    <RadioButton GroupName="XLimitMode" Content="最小值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinOnly}" />
                    <RadioButton GroupName="XLimitMode" Content="最大值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MaxOnly}" />
                    <RadioButton GroupName="XLimitMode" Content="全部" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding XLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinAndMax}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Y-Axis Padding -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Y 轴留白" Foreground="{StaticResource AxisYColor}" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="下端留白（Min）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding YPaddingMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YPaddingMin, StringFormat='当前值：{0:P0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="上端留白（Max）" />
                <Slider Style="{StaticResource PaddingSlider}"
                        Value="{Binding YPaddingMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YPaddingMax, StringFormat='当前值：{0:P0}'}" />
                </Border>

                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y 轴 AutoRange"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding YAutoRange}" />
                    </Grid>
                </Border>

                <!-- Y-Axis VisibleRangeLimit -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Y 轴范围限制" Foreground="{StaticResource AxisYColor}" Margin="0,12,0,8" />

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最小限制（Min）" />
                <Slider Minimum="-30" Maximum="30" SmallChange="0.5" LargeChange="2"
                        TickFrequency="5" Height="28" Margin="0,0,0,6"
                        Value="{Binding YLimitMin, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YLimitMin, StringFormat='当前值：{0:F0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="最大限制（Max）" />
                <Slider Minimum="-30" Maximum="30" SmallChange="0.5" LargeChange="2"
                        TickFrequency="5" Height="28" Margin="0,0,0,6"
                        Value="{Binding YLimitMax, Delay=50}" />
                <Border Style="{StaticResource InfoChip}">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding YLimitMax, StringFormat='当前值：{0:F0}'}" />
                </Border>

                <TextBlock Style="{StaticResource ConfigLabel}" Text="限制模式" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="YLimitMode" Content="不限制" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=None}" />
                    <RadioButton GroupName="YLimitMode" Content="最小值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinOnly}" />
                    <RadioButton GroupName="YLimitMode" Content="最大值" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MaxOnly}" />
                    <RadioButton GroupName="YLimitMode" Content="全部" Style="{StaticResource RadioCard}"
                                 IsChecked="{Binding YLimitMode, Converter={StaticResource LimitModeEqualityConverter}, ConverterParameter=MinAndMax}" />
                </WrapPanel>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Actions -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="快捷操作" />

                <Button Content="↺ 双击图表以执行 ZoomExtents（恢复范围）" Style="{StaticResource ActionButton}"
                        Click="ZoomExtents_Click" />

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- Anti-aliasing -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="渲染选项" />
                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="抗锯齿"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding EnableAntialiasing}" />
                    </Grid>
                </Border>

                <Border Height="1" Background="{StaticResource SectionAccent}" Margin="0,4,0,10" />

                <!-- FPS -->
                <Border Style="{StaticResource InfoChip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="实时帧率"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#4CAF50" VerticalAlignment="Center"
                                   Text="{Binding ElementName=DemoChart, Path=Fps, StringFormat={}{0:F1} FPS}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:ChartDemoViewBase>
