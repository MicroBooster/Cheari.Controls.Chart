<local:ChartDemoViewBase x:Class="Demo.Views.StressTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chart="http://schemas.cheari.com/controls"
             xmlns:local="clr-namespace:Demo.Views"
             xmlns:vm="clr-namespace:Demo.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <chart:Chart x:Name="DemoChart" Grid.Row="0"
                     Background="#1A2238" BorderBrush="#49576E" BorderThickness="0"
                     PlotAreaBackground="#05070B" PlotAreaBorderBrush="#5E708A" PlotAreaBorderThickness="0"
                     Series="{Binding Series}"
                     Modifiers="{Binding Modifiers}"
                     EnableAntialiasing="{Binding EnableAntialiasing}"
                     ShowFps="True">
            <chart:Chart.XAxes>
                <chart:LinearAxis Id="DefaultXAxis"
                                  Placement="Bottom"
                                  VisibleRange="0,1000"
                                  AutoRange="True"
                                  AlignRangeToTicks="True"
                                  Title="Time (s)"
                                  LabelFormat="F1"
                                  ShowMajorGridLines="True"
                                  ShowMinorGridLines="False"
                                  MajorGridLineThickness="1" />
            </chart:Chart.XAxes>
            <chart:Chart.YAxes>
                <chart:LinearAxis Id="DefaultYAxis"
                                  Placement="Left"
                                  VisibleRange="-2,2"
                                  AutoRange="True"
                                  AlignRangeToTicks="True"
                                  Title="Amplitude"
                                  LabelFormat="F2"
                                  ShowMajorGridLines="True"
                                  ShowMinorGridLines="False"
                                  MajorGridLineThickness="1" />
            </chart:Chart.YAxes>
        </chart:Chart>

        <Border Grid.Row="1" Background="#1E2A3A" BorderBrush="#49576E" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,6">测试模式</TextBlock>
                    <ComboBox SelectedItem="{Binding TestMode}" FontSize="12" Height="28">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <vm:StressTestMode>StaticBigData</vm:StressTestMode>
                        <vm:StressTestMode>StreamingHighFreq</vm:StressTestMode>
                        <vm:StressTestMode>MixedSeries</vm:StressTestMode>
                        <vm:StressTestMode>MultiSeriesStream</vm:StressTestMode>
                    </ComboBox>
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="4" Margin="20,0,20,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4">
                            <Run Text="数据点数 " /><Run Text="{Binding PointCount, Mode=OneWay}" Foreground="#00FF00" />
                        </TextBlock>
                        <Slider Minimum="1000" Maximum="10000000" Value="{Binding PointCount}" SmallChange="10000" LargeChange="100000" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4">
                            <Run Text="系列数 " /><Run Text="{Binding SeriesCount, Mode=OneWay}" Foreground="#00FF00" />
                        </TextBlock>
                        <Slider Minimum="1" Maximum="100" Value="{Binding SeriesCount}" SmallChange="1" LargeChange="5" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4">
                            <Run Text="更新频率 " /><Run Text="{Binding UpdateRateHz, Mode=OneWay}" Foreground="#00FF00" /><Run Text=" Hz" />
                        </TextBlock>
                        <Slider Minimum="10" Maximum="1000" Value="{Binding UpdateRateHz}" SmallChange="10" LargeChange="50" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4">
                            <Run Text="FIFO " /><Run Text="{Binding FifoCapacity, Mode=OneWay}" Foreground="#00FF00" />
                        </TextBlock>
                        <Slider Minimum="100" Maximum="1000000" Value="{Binding FifoCapacity}" SmallChange="1000" LargeChange="10000" />
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ 运行" Width="70" Height="30" Margin="0,0,8,0"
                            Command="{Binding RunTestCommand}"
                            Background="#2D6A4F" Foreground="White" BorderBrush="#40916C" FontWeight="Bold" />
                    <Button Content="■ 停止" Width="70" Height="30" Margin="0,0,8,0"
                            Command="{Binding StopTestCommand}"
                            Background="#9B2226" Foreground="White" BorderBrush="#AE2012" FontWeight="Bold" />
                    <Button Content="↺ 重置" Width="70" Height="30" Margin="0,0,12,0"
                            Command="{Binding ResetCommand}"
                            Background="#4A5568" Foreground="White" BorderBrush="#5E708A" />
                    <Border Background="#0D1117" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Foreground="#00FF00" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                   Text="{Binding ElementName=DemoChart, Path=Fps, StringFormat=FPS {0:F1}}" />
                    </Border>
                    <Border Background="#0D1117" CornerRadius="4" Padding="10,4">
                        <TextBlock Foreground="#FFD700" FontSize="12" FontFamily="Consolas"
                                   Text="{Binding StatusText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:ChartDemoViewBase>
